# Copy to .env and fill in locally. Never commit .env (it is Git-ignored).
#
# LLM settings for the OpenAI-compatible endpoint (D-036). Model and settings: D-067
# (openai/gpt-oss-120b on GroqCloud). Only the API key is required; the other two default
# to the D-067 values in src/bto_buddy/llm.py.
BTO_BUDDY_LLM_API_KEY=
BTO_BUDDY_LLM_BASE_URL=
BTO_BUDDY_LLM_MODEL=
# Model-selection harness only (evaluation/model_selection.py); GROQ_API_KEY is also accepted
# as a fallback for BTO_BUDDY_LLM_API_KEY.
GROQ_API_KEY=
GEMINI_API_KEY=
